APP_NAME=Enterprise Agent Platform
# 数据库：SQLite（默认，仅开发）或 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_platform
DATABASE_URL=sqlite:///./agent_platform.db
CORS_ORIGINS=http://localhost:5173
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# 创建 Agent 时未显式指定 model 所使用的默认模型
MODEL_NAME=gpt-4o-mini
# 单次请求的上下文预算（字符），超出则丢弃最旧的历史消息
CONTEXT_MAX_CHARS=24000
# 一次 Agent 运行内允许的最大工具调用轮次
MAX_TOOL_ITERATIONS=4
# 认证开关。默认 true；设为 false 等于匿名管理员，仅限本地开发
AUTH_ENABLED=true
# 初始管理员密钥。留空则首次启动自动生成并打印在日志里（仅显示一次）
BOOTSTRAP_ADMIN_API_KEY=
# 每个密钥每分钟允许的请求数，0 表示不限流
RATE_LIMIT_PER_MINUTE=120
# 限流后端：memory（进程内，单实例）或 redis（多副本共享）
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_BACKEND=redis 时必填，例如 redis://localhost:6379/0
REDIS_URL=
# 每个密钥 24 小时内允许发起的 Agent 运行数，0 表示不限额
DAILY_RUN_QUOTA=200
# MCP 服务器清单（只能由运维在这里声明，API 无法注册）：
# MCP_SERVERS={"echo": {"command": "python", "args": ["path/to/server.py"], "timeout_seconds": 10}}
MCP_SERVERS={}
# 单次 MCP 调用允许的最长等待（秒），与工具自身 timeout 取较小值
MCP_TIMEOUT_SECONDS=30
# 注入 system prompt 的技能内容字符上限，超出则截断
SKILL_MAX_CHARS=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
